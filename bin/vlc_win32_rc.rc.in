/* Coneic product version is independent of the retained VLC engine version.
 * Keep these values aligned with coneic/windows/product.json. */
#define VERSION_NUMBER 0,5,0,0
#define VERSION_NUMBER_STR "0.5.0"

#include <winuser.h>

VLC_ICON ICON "vlc.ico"

1 VERSIONINFO
FILETYPE 1
FILEOS 4
PRODUCTVERSION VERSION_NUMBER
FILEVERSION VERSION_NUMBER
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "BLUECLOUD"
      VALUE "ProductName", "Coneic"
      VALUE "ProductVersion", VERSION_NUMBER_STR
      VALUE "InternalName", "Coneic"
      VALUE "OriginalFilename", "Coneic.exe"
      VALUE "FileVersion", "0.5.0.0"
      VALUE "FileDescription", "Coneic media player (VLC source fork)"
      VALUE "LegalCopyright", "Copyright \251 @COPYRIGHT_YEARS@ VideoLAN and VLC Authors"
      VALUE "LegalTrademarks", "VLC media player, VideoLAN and x264 are registered trademarks from VideoLAN"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "vlc.exe.manifest"
